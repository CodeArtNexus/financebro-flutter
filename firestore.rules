rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function propietario(uid) { return request.auth != null && request.auth.uid == uid; }
    function administrador() { return request.auth != null && request.auth.token.get('financebroAdmin', false) == true; }
    function perfilValido() {
      return request.resource.data.keys().hasOnly(['nombre', 'segmento', 'mostrarSaldo', 'actualizado'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 60
        && request.resource.data.segmento in ['equilibrio', 'ahorro', 'viajes']
        && request.resource.data.mostrarSaldo is bool && request.resource.data.actualizado == request.time;
    }
    function rutaCuenta(uid, cuenta) { return /databases/$(database)/documents/usuarios/$(uid)/cuentas/$(cuenta); }
    match /usuarios/{uid} {
      allow read: if propietario(uid) || administrador();
      allow create, update: if propietario(uid) && perfilValido();
      match /cuentas/{cuenta} {
        allow read: if propietario(uid) || administrador();
        allow write: if false;
        match /movimientos/{movimiento} { allow read: if propietario(uid) || administrador(); allow write: if false; }
      }
      match /{coleccion}/{id} {
        allow read: if (propietario(uid) || administrador()) && coleccion in ['operaciones','pagos','movimientosGlobales','contactos','tarjetas','solicitudes','autopagos'];
        allow write: if false;
        match /{subcoleccion}/{subid} { allow read: if (propietario(uid) || administrador()) && coleccion in ['contactos','tarjetas','solicitudes','autopagos']; }
      }
      match /datosPersonales/{id} { allow read: if propietario(uid); allow write: if false; }
      match /metas/{meta} {
        allow read, delete: if propietario(uid);
        allow create, update: if propietario(uid)
          && request.resource.data.keys().hasOnly(['nombre','cuenta','objetivoCentavos','aporteMensualCentavos','fechaObjetivo','actualizado'])
          && request.resource.data.nombre is string && request.resource.data.nombre.size() >= 2 && request.resource.data.nombre.size() <= 60
          && request.resource.data.cuenta is string && request.resource.data.cuenta.matches('^[a-zA-Z0-9_-]{1,80}$')
          && exists(rutaCuenta(uid, request.resource.data.cuenta))
          && request.resource.data.objetivoCentavos is int && request.resource.data.objetivoCentavos >= 100 && request.resource.data.objetivoCentavos <= 100000000
          && request.resource.data.aporteMensualCentavos is int && request.resource.data.aporteMensualCentavos >= 100 && request.resource.data.aporteMensualCentavos <= request.resource.data.objetivoCentavos
          && request.resource.data.fechaObjetivo is timestamp && request.resource.data.fechaObjetivo > request.time && request.resource.data.fechaObjetivo <= request.time + duration.value(3653, 'd')
          && request.resource.data.actualizado == request.time;
      }
      match /dispositivos/{dispositivo} {
        allow read, delete: if propietario(uid);
        allow create, update: if propietario(uid)
          && request.resource.data.keys().hasOnly(['token','actualizado'])
          && request.resource.data.token is string && request.resource.data.token.size() <= 4096
          && request.resource.data.actualizado == request.time;
      }
      match /notificaciones/{notificacion} { allow read: if propietario(uid); }
    }
    match /servicios/{id} { allow read: if request.auth != null; allow write: if false; }
    match /{path=**}/solicitudes/{id} { allow read: if administrador(); }
    match /{path=**}/autopagos/{id} { allow read: if administrador(); }
    match /comercios/{id} { allow read: if request.auth != null; }
    match /experiencias/{version} { allow read: if request.auth != null; }
    match /{path=**}/movimientosGlobales/{id} { allow read: if administrador(); }
    match /{path=**}/movimientos/{id} { allow read: if administrador(); }
    match /{path=**}/cuentas/{id} { allow read: if administrador(); }
    match /{document=**} { allow read, write: if false; }
  }
}
