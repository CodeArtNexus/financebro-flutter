rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function propietario(uid) { return request.auth != null && request.auth.uid == uid; }
    function administrador() { return request.auth != null && request.auth.token.get('financebroAdmin', false) == true; }
    function editable(uid) {
      return firestore.get(/databases/(default)/documents/usuarios/$(uid)/solicitudes/corriente).data.estado in ['borrador','correcciones'];
    }
    match /expedientes/{uid}/corriente/{categoria}/{archivo} {
      allow read: if propietario(uid) || administrador();
      allow create: if resource == null && propietario(uid) && editable(uid)
        && categoria in ['constitucion','estatutos','nombramiento','ruc','balances']
        && archivo.matches('^[a-zA-Z0-9_-]{8,80}[.](pdf|png|jpg)$')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['application/pdf','image/png','image/jpeg'];
      allow update, delete: if false;
    }
    match /tarjetas/{uid}/{tarjeta}/fondos/{archivo} {
      allow read: if propietario(uid) || administrador();
      allow create: if resource == null && propietario(uid)
        && firestore.get(/databases/(default)/documents/usuarios/$(uid)/tarjetas/$(tarjeta)).data.tipo == 'propia'
        && archivo.matches('^[a-zA-Z0-9_-]{8,80}[.](png|jpg)$')
        && request.resource.size > 0 && request.resource.size <= 2*1024*1024
        && request.resource.contentType in ['image/png','image/jpeg'];
      allow update, delete: if false;
    }
    match /{archivo=**} { allow read, write: if false; }
  }
}
